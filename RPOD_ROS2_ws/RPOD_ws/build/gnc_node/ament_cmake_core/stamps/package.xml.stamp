<?xml version="1.0"?>
<package format="3">

  <name>gnc_node</name>

  <version>0.0.1</version>

  <description>ROS2 wrapper for Simulink GNC MPC controller</description>

  <maintainer email="your@email.com">
    Robotics Team
  </maintainer>

